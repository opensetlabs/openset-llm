#!/usr/bin/env bash
# serve: chat page at / and an OpenAI-compatible server (POST /v1/chat/completions) on the model install.sh prepared.
#
#   ./serve                       # 127.0.0.1:8080, 4k context, speculative decoding on, thinking off
#   ./serve --host 0.0.0.0 --port 8080 --ctx 8192 --threads 8   # 8k on 8 GB: plain decoding, ~1 GB to spare
#   ./serve --multi 4             # 4 requests decode together: ~2.3x the total tok/s; no speculation, 2k ctx each;
#                                 #   a system prompt the streams share is read once and then loaded from disk
#   ./serve --no-webui            # API only: do not serve the chat page at /
#   ./serve --no-spec             # plain decoding (no speculation)
#   ./serve --spec                # keep speculation on where serve would turn it off: for lack of memory
#                                 #   (< 12 GB RAM: --ctx > 4096; > 8192 with --kv8; > 12288 with --kv6; > 16384 with --kv5)
#                                 #   or on a CPU without AVX-512 VNNI (AVX2 / AVX-VNNI: speculation speeds up code and JSON there and slows down prose)
#                                 #   or on a Mac, where it is off by default (slower than plain decoding on the GPU there)
#   ./serve --think               # let the model think before answering (much longer replies)
#   ./serve --no-resume           # turn off agent-loop resume (default on; saved prefix states live in $OPENSET_LLM_HOME/state)
#   ./serve --kv6 | --kv5         # EXPERIMENTAL: 6- / 5-bit attention cache, 38 % / 32 % of the default cache; on 8 GB:
#                                 #   speculation up to 12k (kv6) / 16k (kv5) context, plain decoding to 32k (kv6) / 64k (kv5);
#                                 #   not exact; needs AVX-512; choose one of --kv8, --kv6, --kv5
#   ./serve --kv8                 # EXPERIMENTAL: int8 attention cache: 43 % less cache memory, helps on long prompts; not exact
#   ./serve --fl128               # EXPERIMENTAL: a faster variant that is not bit-identical
#   ./serve --spec-adapt          # EXPERIMENTAL: adaptive draft depth (--spec-depth N; default 3, 5 on >= 12 GB RAM)
#   ./serve -- <extra llama-server flags>
#
# Defaults are the fastest settings.
[ "${BASH_VERSINFO[0]}" -ge 4 ] || { echo "this needs bash 4 or newer (macOS ships 3.2): brew install bash, then run it again" >&2; exit 1; }
set -euo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PREFIX=${OPENSET_LLM_HOME:-$HOME/.openset-llm}
OS=$(uname -s)
if [ "$OS" = Darwin ]; then THREADS=$(sysctl -n hw.perflevel0.physicalcpu); else THREADS=$(nproc); fi
HOST=127.0.0.1; PORT=8080; CTX=; SPEC=1; SPEC_FORCE=0; X1=1; MULTI=0; THINK=off; EXTRA=(); ADAPT=0; DEPTH=; FL128=0; KV8=0; KVQ=0; RESUME=1; WEBUI=1
while [ $# -gt 0 ]; do
  case $1 in
    --host|--port|--ctx|--threads|--multi|--spec-depth) [ $# -ge 2 ] || { echo "$1 needs a value" >&2; exit 2; } ;;&
    --host) HOST=$2; shift ;;
    --port) PORT=$2; shift ;;
    --ctx) CTX=$2; shift ;;
    --threads) THREADS=$2; shift ;;
    --multi) MULTI=$2; shift ;;
    --no-spec) SPEC=0 ;;
    --spec) SPEC_FORCE=1 ;;
    --no-x1) X1=0 ;;
    --think) THINK=on ;;
    --spec-adapt) ADAPT=1 ;;
    --spec-depth) DEPTH=$2; shift ;;
    --fl128) FL128=1 ;;
    --kv8) KV8=1 ;;
    --kv6|--kv5) [ "$KVQ" = 0 ] || { echo "choose one of --kv8, --kv6, --kv5" >&2; exit 2; }; KVQ=${1#--kv} ;;
    --no-resume) RESUME=0 ;;
    --no-webui) WEBUI=0 ;;
    --) shift; EXTRA=("$@"); break ;;
    -h|--help) sed -n '2,23p' "$0"; exit 0 ;;
    *) echo "unknown option: $1 (pass llama-server flags after --)" >&2; exit 2 ;;
  esac
  shift
done
BIN=$PREFIX/bin; MODEL=$PREFIX/models/model.gguf
[ -x "$BIN/llama-server" ] && [ -f "$MODEL" ] || { echo "not installed: run ./install.sh first" >&2; exit 1; }
[ -f "$PREFIX/models/no-mtp" ] && SPEC=0
case $MULTI in ''|*[!0-9]*) echo "--multi takes a number of streams (2-8)" >&2; exit 2 ;; esac
for v in "$PORT" "$THREADS" ${CTX:+"$CTX"} ${DEPTH:+"$DEPTH"}; do
  case $v in ''|*[!0-9]*) echo "--port, --ctx, --threads and --spec-depth take a number (got: $v)" >&2; exit 2 ;; esac
done
# Bash arithmetic treats leading zeroes as octal; CLI numbers are decimal.
for numeric_name in PORT THREADS CTX MULTI DEPTH; do
  numeric_value=${!numeric_name}
  [ -n "$numeric_value" ] || continue
  numeric_value=${numeric_value#"${numeric_value%%[!0]*}"}
  numeric_value=${numeric_value:-0}
  # llama-server parses these options as signed 32-bit integers. Check strings
  # before Bash arithmetic can wrap an oversized context into a different value.
  if [ "${#numeric_value}" -gt 10 ] || { [ "${#numeric_value}" -eq 10 ] && [[ $numeric_value > 2147483647 ]]; }; then
    echo "--port, --ctx, --threads, --multi and --spec-depth must not exceed 2147483647 (got: $numeric_value)" >&2
    exit 2
  fi
  printf -v "$numeric_name" '%s' "$numeric_value"
done
CKPT=1; RESUME_MODE=full
if [ "$MULTI" -ge 2 ]; then
  # X2: N streams share each pass over the weights. --ctx is per stream here. Speculation is off (X1/MTP + X2 is untested).
  [ "$MULTI" -gt 8 ] && { echo "--multi: at most 8 streams" >&2; exit 2; }
  [ "$MULTI" -gt 6 ] && echo "warning: --multi $MULTI > 6: measured 8 streams leave < 0.3 GB free on an 8 GB machine" >&2
  [ "$SPEC" = 1 ] && echo "note: --multi turns speculation off (the two together are untested)" >&2
  SPEC=0
  [ -z "$CTX" ] && { [ "$MULTI" -le 4 ] && CTX=2048 || CTX=1024; }
  [ "$CTX" -le $((2147483647 / MULTI)) ] || { echo "--ctx times --multi must not exceed 2147483647" >&2; exit 2; }
  NP=$MULTI; CTX_TOTAL=$((CTX * MULTI)); CKPT=0
  # Resume with several streams (0010; measured 2026-11-25 on 8 vCPU / 8 GB boxes with 2, 4 and 6 streams): the state at
  # the end of the system(+tools) prompt is written to disk once and loaded by every stream that cannot continue what it
  # holds (a new conversation, a rewritten ending, a restart). No checkpoint in RAM, the prompt is read in the same
  # batches as without it, and every generated token's logprobs came out equal to --no-resume.
  # The per-stream checkpoint of the single-stream server (the exact resume point after a rewritten ending) stays off
  # here: ~150 MiB of RAM per stream (4 x 2048 on 8 GB: 0.08 GB left) and logprobs not always bit-equal to --no-resume.
  # It can be tried with:  ./serve --multi N -- --ctx-checkpoints 1
  [ "$RESUME" = 1 ] && RESUME_MODE=prefix
  export GGML_X2=${GGML_X2:-95} LLAMA_X2_SERIAL_PREFILL=${LLAMA_X2_SERIAL_PREFILL:-1} LLAMA_X2_CKPT_SPLIT=${LLAMA_X2_CKPT_SPLIT:-1}
  if [ "$CTX_TOTAL" -gt 8192 ]; then
    echo "warning: $MULTI streams x $CTX tokens = $CTX_TOTAL > 8192 total; measured safe on 8 GB: 4 x 2048, 6 x 1024" >&2
  fi
else
  NP=1; CTX=${CTX:-4096}; CTX_TOTAL=$CTX
  if [ "$CTX" -gt 8192 ] && [ "$KV8" = 0 ] && [ "$KVQ" = 0 ]; then
    echo "warning: --ctx $CTX > 8192. On an 8 GB machine the KV cache and recurrent-state checkpoints can push the" >&2
    echo "         server past RAM; 8192 is the measured-safe limit there (--kv8, --kv6 or --kv5 go further)." >&2
  fi
fi
args=(-m "$MODEL" -t "$THREADS" -c "$CTX_TOTAL" -ub 256 -np "$NP"
      --cache-ram 0 --ctx-checkpoints "$CKPT"   # the default 8 GiB host prompt cache would OOM an 8 GB box
      --reasoning "$THINK" --host "$HOST" --port "$PORT")
[ "$OS" = Darwin ] && args+=(-ngl 99)
[ "$WEBUI" = 0 ] && args+=(--no-webui)
ALIAS=openset-llm   # the model id the API reports (instead of the model file's path); your own --alias after -- wins
for a in "${EXTRA[@]}"; do case $a in -a|--alias) ALIAS= ;; esac; done
[ -n "$ALIAS" ] && args+=(--alias "$ALIAS")
SPECNAME=off
# RAM for the guard rails below: MemTotal, or the container's memory limit when that is lower (Docker and other container hosts
# report the host's MemTotal; install.sh already checks the cgroup the same way)
if [ "$OS" = Darwin ]; then
  MEM_KB=$(( $(sysctl -n hw.memsize) / 1024 ))
else
  MEM_KB=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  if [ -r /sys/fs/cgroup/memory.max ] && [ "$(cat /sys/fs/cgroup/memory.max)" != max ]; then
    lim_kb=$(( $(cat /sys/fs/cgroup/memory.max) / 1024 )); [ "$lim_kb" -lt "$MEM_KB" ] && MEM_KB=$lim_kb
  fi
fi
if [ "$RESUME" = 1 ]; then
  # 0007: one checkpoint in RAM (as before), placed where the next request will resume; prefix states on disk (~0.3 GB each)
  export LLAMA_RESUME=${LLAMA_RESUME:-1} LLAMA_RESUME_DIR=${LLAMA_RESUME_DIR-$PREFIX/state}
  [ "$RESUME_MODE" = prefix ] && export LLAMA_RESUME_PREFIX_ONLY=${LLAMA_RESUME_PREFIX_ONLY:-1}
else
  export LLAMA_RESUME=0 LLAMA_RESUME_DIR=
fi
[ "$FL128" = 1 ] && export GGML_PTQ1_FL128=${GGML_PTQ1_FL128:-1} GGML_PTQ1_K4=${GGML_PTQ1_K4:-2}
# Without AVX-512 VNNI the engine runs on the 256-bit kernels (AVX2, AVX-VNNI where the CPU has it). Checking a draft
# of 3 tokens costs about twice a single token there (1.1-1.2 times on the AVX-512 kernels), so speculation only pays
# where the drafts are usually right:
# measured with AVX-512 switched off on Ice Lake boxes (2026-11-26, 128 prompts of 10 kinds, drafting 2 tokens ahead):
# 1.2-1.4x plain decoding on code, JSON, maths and tool calls, 0.9-1.0x on prose, translation and summaries (3 tokens
# ahead: 0.8-0.85x there). So it stays off unless --spec asks for it, and --spec drafts 2 tokens ahead on these CPUs.
# With AVX-512 VNNI but no VBMI it still helps (7.8 vs 6.6 tok/s), so it stays on.
if [ "$SPEC" = 1 ] && [ "$MULTI" -lt 2 ] && [ "$OS" = Darwin ]; then
  if [ "$SPEC_FORCE" = 0 ]; then
    echo "note: on a Mac speculation is off (with this fork it is slower than plain decoding on the GPU: 2.5-2.8 vs 6.8-7.3 tok/s in bench/quick.sh on an M4); --spec forces it" >&2
    SPEC=0
  fi
  X1=0
elif [ "$SPEC" = 1 ] && [ "$MULTI" -lt 2 ]; then
  case " $(grep -m1 '^flags' /proc/cpuinfo 2>/dev/null | cut -d: -f2) " in
    *" avx512_vnni "*) ;;
    *) if [ "$SPEC_FORCE" = 0 ]; then
         echo "note: this CPU has no AVX-512 VNNI: speculation off (on this kind of CPU it speeds up code and JSON and slows down prose); --spec forces it" >&2
         SPEC=0
       elif [ -z "$DEPTH" ] && [ "$ADAPT" = 0 ]; then
         DEPTH=2   # drafting 2 tokens ahead instead of 3: the better depth on the 256-bit kernels (--spec-depth N overrides)
       fi ;;
  esac
fi
[ "$KV8" = 1 ] && [ "$KVQ" != 0 ] && { echo "choose one of --kv8, --kv6, --kv5" >&2; exit 2; }
[ "$OS" = Darwin ] && { [ "$KV8" = 1 ] || [ "$KVQ" != 0 ]; } && { echo "--kv8, --kv6 and --kv5 run in this repo's x86 attention kernel; they are not available on a Mac" >&2; exit 2; }
if [ "$KVQ" != 0 ]; then
  # the 6- / 5-bit rows are read by the AVX-512 attention kernel only; the int8 cache (--kv8) also runs without it
  case " $(grep -m1 '^flags' /proc/cpuinfo 2>/dev/null | cut -d: -f2) " in
    *" avx512bw "*) ;;
    *) echo "--kv$KVQ needs a CPU with AVX-512; on this CPU use --kv8 (int8 attention cache) instead" >&2; exit 2 ;;
  esac
  # measured on 8 vCPU / 8 GB (2026-11-21): kv6 runs to 32k and kv5 to 64k with ~0.1-0.7 GB to spare; past that the
  # server is OOM-killed at load or stalls
  KVQ_CTX_MAX=32768; [ "$KVQ" = 5 ] && KVQ_CTX_MAX=65536
  if [ "$MEM_KB" -lt 12000000 ] && [ "$CTX_TOTAL" -gt "$KVQ_CTX_MAX" ]; then
    echo "--ctx $CTX_TOTAL with --kv$KVQ does not fit in < 12 GB of RAM: the measured limit is $KVQ_CTX_MAX" >&2; exit 2
  fi
fi
[ "$KV8" = 1 ] && args+=(-ctk q8_K -ctv q8_K)   # needs patch 0008 (attn-fast.inc); f16 KV is the exact default
[ "$KVQ" != 0 ] && args+=(-ctk "kv$KVQ" -ctv "kv$KVQ")   # patch 0009 (kvq.h): 6- / 5-bit rows, 38 % / 32 % of the f16 cache
# measured on 8 GB. kv6 at a full 16k context pages (5.8-6.7 tok/s, slower than plain decoding); it holds to 14k, kv5 to 16k
SPEC_CTX_MAX=4096; [ "$KV8" = 1 ] && SPEC_CTX_MAX=8192; [ "$KVQ" = 6 ] && SPEC_CTX_MAX=12288; [ "$KVQ" = 5 ] && SPEC_CTX_MAX=16384
if [ "$SPEC" = 1 ] && [ "$MULTI" -lt 2 ] && [ "$SPEC_FORCE" = 0 ] && \
   [ "$CTX" -gt "$SPEC_CTX_MAX" ] && \
   [ "$MEM_KB" -lt 12000000 ]; then
  # with patch 0008 the verify batch is fast at any depth (16 GB: MTP 1.6-1.7x plain at 4k-32k), but on 8 GB the draft
  # state + f16 KV leave < 0.1 GB free above 4k and page reclaim makes MTP slower than plain decode (8k: 6.5 vs 7.5 tok/s);
  # with --kv8 the int8 KV leaves room and MTP wins again at 8k (10.9 tok/s); at 16k MTP does not fit 8 GB either way.
  # (measured 2026-11-10 on an 8 vCPU / 8 GB Ice Lake box)
  echo "note: --ctx $CTX on < 12 GB RAM: speculation off (it is slower than plain decode here or does not fit: memory);" >&2
  if [ "$KV8" = 0 ] && [ "$KVQ" = 0 ]; then
    echo "      a compact attention cache keeps it on further: --kv8 to 8192, --kv6 to 12288, --kv5 to 16384; --spec forces it" >&2
  else
    echo "      the limit with this cache is --ctx $SPEC_CTX_MAX (--kv8 8192, --kv6 12288, --kv5 16384); --spec forces it" >&2
  fi
  SPEC=0
fi
if [ "$SPEC" = 1 ]; then
  mem_kb=$MEM_KB
  if [ "$ADAPT" = 1 ]; then
    # each draft position keeps one recurrent-state snapshot plane (~0.14 GB per depth step at 48 GDN layers), so the
    # depth range is 0..3 on < 12 GB RAM unless --spec-depth says otherwise; the server's "no draft this step" path is depth 0
    [ -z "$DEPTH" ] && { [ "$mem_kb" -ge 12000000 ] && DEPTH=5 || DEPTH=3; }
    export LLAMA_SPEC_ADAPT=${LLAMA_SPEC_ADAPT:-1}
    args+=(--spec-type draft-mtp --spec-draft-n-max "$DEPTH"); SPECNAME="adaptive"
  else
    args+=(--spec-type draft-mtp --spec-draft-n-max "${DEPTH:-3}"); SPECNAME="on (lower-memory mode)"
  fi
  if [ "$X1" = 1 ] && [ "$CTX" -gt 4096 ] && [ "$mem_kb" -lt 12000000 ]; then
    # X1 holds ~0.2 GB more (draft panels + 65k head); at 4k context an 8 GB box keeps ~0.13 GB free, at 8k it would not
    echo "note: --ctx $CTX on < 12 GB RAM: using the lower-memory speculation mode (same outputs, a little slower)" >&2
    X1=0
  fi
  if [ "$X1" = 1 ]; then
    # X1: faster speculation cycle + a 65k-token draft head; the draft head falls back to the full vocabulary while
    # more than 20 % of the recent tokens are outside the 65k list (non-Latin text). Outputs = MTP-3 without X1.
    IDS=$HERE/data/x1-draft-ids.txt
    [ -f "$IDS" ] || IDS=$PREFIX/x1-draft-ids.txt
    if [ -f "$IDS" ]; then
      export GGML_X1=${GGML_X1:-109} LLAMA_ARG_REPACK=${LLAMA_ARG_REPACK:-0} X1_MTP_ANCHOR_ONLY=${X1_MTP_ANCHOR_ONLY:-1} \
             X1_DRAFT_VOCAB=${X1_DRAFT_VOCAB:-65536} X1_DRAFT_IDS=${X1_DRAFT_IDS:-$IDS} X1_Q6_AS_Q4=${X1_Q6_AS_Q4:-1} \
             X1_DRAFT_FALLBACK=${X1_DRAFT_FALLBACK:-0.2}
      [ "$ADAPT" = 1 ] && SPECNAME="adaptive" || SPECNAME="on"
    else
      echo "note: a data file in data/ was not found; using the lower-memory speculation mode (same outputs)" >&2
    fi
  fi
fi
export LD_LIBRARY_PATH="$BIN${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
SHOW=$HOST; [ "$HOST" = 0.0.0.0 ] && SHOW=127.0.0.1
[ "$WEBUI" = 1 ] && echo "chat: open http://$SHOW:$PORT in a browser (the page answers once the model has loaded)" >&2
echo "serving on http://$HOST:$PORT/v1 (speculation: $SPECNAME, streams: $NP, ctx: $CTX_TOTAL, thinking: $THINK, resume: $([ "$RESUME" = 0 ] && echo off || { [ "$RESUME_MODE" = prefix ] && echo "on (shared prefix)" || echo on; }))" >&2
exec "$BIN/llama-server" "${args[@]}" "${EXTRA[@]}"
